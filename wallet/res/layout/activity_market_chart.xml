<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/chart_bg">

    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/chart_bg"
        app:title="@string/market_chart_title"
        app:titleTextColor="@color/chart_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/chart_screen_padding">

        <TextView
            android:id="@+id/textCurrentPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textSize="@dimen/chart_price_large_size"
            android:textStyle="bold"
            android:textColor="@color/chart_text" />

        <TextView
            android:id="@+id/textCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chart_countdown_default"
            android:textSize="@dimen/chart_text_size"
            android:textColor="@color/chart_last_price_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/chart_small_margin">

            <TextView
                android:id="@+id/textHigh24h"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/chart_high_default"
                android:textColor="@color/chart_text"
                android:textSize="@dimen/chart_text_size" />

            <TextView
                android:id="@+id/textLow24h"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/chart_low_default"
                android:textColor="@color/chart_text"
                android:textSize="@dimen/chart_text_size" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTimeframe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:chipSpacing="@dimen/chart_chip_spacing"
            android:layout_marginTop="@dimen/chart_small_margin" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <wallet.ui.MarketChartView
            android:id="@+id/marketChartView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/popupCandleDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/chart_popup_bg"
            android:padding="@dimen/chart_popup_padding"
            android:visibility="gone"
            android:layout_margin="@dimen/chart_small_margin">

            <TextView android:id="@+id/popupTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/chart_popup_text" android:textSize="@dimen/chart_popup_time_size" />
            <TextView android:id="@+id/popupOpen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/chart_bull" android:textSize="@dimen/chart_popup_size" />
            <TextView android:id="@+id/popupHigh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/chart_bull" android:textSize="@dimen/chart_popup_size" />
            <TextView android:id="@+id/popupLow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/chart_bear" android:textSize="@dimen/chart_popup_size" />
            <TextView android:id="@+id/popupClose" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/chart_popup_text" android:textSize="@dimen/chart_popup_size" android:textStyle="bold" />
            <TextView android:id="@+id/popupVolume" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/chart_text" android:textSize="@dimen/chart_popup_time_size" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
