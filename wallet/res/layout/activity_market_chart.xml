<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/font_size_huge"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/chart_screen_padding"
        android:paddingEnd="@dimen/chart_screen_padding"
        android:background="?android:attr/colorBackground">

        <TextView
            android:id="@+id/textMarketTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/market_chart_title"
            android:textSize="@dimen/font_size_large"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/chart_screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/textCurrentPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chart_price_default"
                        android:textSize="@dimen/chart_price_large_size"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary" />

                    <TextView
                        android:id="@+id/textChange24h"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/chart_small_margin"
                        android:text="@string/chart_change_default"
                        android:textSize="@dimen/chart_text_size"
                        android:textColor="@color/chart_bull" />

                </LinearLayout>

                <TextView
                    android:id="@+id/textCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/list_entry_padding_vertical_cram"
                    android:text="@string/chart_countdown_default"
                    android:textSize="@dimen/font_size_tiny"
                    android:textColor="?android:attr/textColorSecondary" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/textHigh24h"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chart_high_default"
                    android:textSize="@dimen/font_size_tiny"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:id="@+id/textLow24h"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/list_entry_padding_vertical_cram"
                    android:text="@string/chart_low_default"
                    android:textSize="@dimen/font_size_tiny"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:id="@+id/textVolBtc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/list_entry_padding_vertical_cram"
                    android:text="@string/chart_vol_base_default"
                    android:textSize="@dimen/font_size_tiny"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:id="@+id/textVolFiat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/list_entry_padding_vertical_cram"
                    android:text="@string/chart_vol_quote_default"
                    android:textSize="@dimen/font_size_tiny"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:id="@+id/textVol24h"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:text="@string/chart_vol_default" />

                <TextView
                    android:id="@+id/textFiat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:text="@string/chart_fiat_default" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/textMaLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/chart_small_margin"
            android:text="@string/chart_ma_default"
            android:textSize="@dimen/font_size_tiny" />

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="?android:attr/colorBackground">

        <LinearLayout
            android:id="@+id/chipGroupTimeframe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:weightSum="7"
            android:paddingStart="@dimen/chart_small_margin"
            android:paddingEnd="80dp"
            android:paddingTop="@dimen/list_entry_padding_vertical_cram"
            android:paddingBottom="@dimen/list_entry_padding_vertical_cram"
            android:background="?android:attr/colorBackground" />

    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <wallet.ui.MarketChartView
            android:id="@+id/marketChartView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="0dp" />

        <LinearLayout
            android:id="@+id/popupCandleDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="@dimen/chart_popup_padding"
            android:layout_margin="@dimen/chart_small_margin"
            android:background="?android:attr/colorBackground">

            <TextView
                android:id="@+id/popupTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chart_popup_time_default"
                android:textSize="@dimen/chart_popup_time_size"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/popupOpen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chart_popup_open_default"
                android:textSize="@dimen/chart_popup_size"
                android:textColor="@color/chart_bull" />

            <TextView
                android:id="@+id/popupHigh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chart_popup_high_default"
                android:textSize="@dimen/chart_popup_size"
                android:textColor="@color/chart_bull" />

            <TextView
                android:id="@+id/popupLow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chart_popup_low_default"
                android:textSize="@dimen/chart_popup_size"
                android:textColor="@color/chart_bear" />

            <TextView
                android:id="@+id/popupClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chart_popup_close_default"
                android:textSize="@dimen/chart_popup_size"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/popupVolume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chart_popup_volume_default"
                android:textSize="@dimen/chart_popup_time_size"
                android:textColor="?android:attr/textColorSecondary" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
