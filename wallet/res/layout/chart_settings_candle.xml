<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chart_settings_candle"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <!-- Bullish Color - set từng layout riêng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chart_settings_bullish"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/color_picker_border">

            <View
                android:id="@+id/viewBull"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:background="@color/chart_bull_default"
                android:tag="@color/chart_bull_default" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bearish Color - set từng layout riêng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chart_settings_bearish"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/color_picker_border">

            <View
                android:id="@+id/viewBear"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:background="@color/chart_bear_default"
                android:tag="@color/chart_bear_default" />
        </FrameLayout>
    </LinearLayout>

    <!-- Wick Width - layout con riêng, trước để ở xml cha nên thiếu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/lbWick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chart_wick_width"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sbWick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10"
            android:progress="2" />
    </LinearLayout>

    <!-- Body Width - thêm vào cho đủ, trước nằm ở options nhưng cần cho candle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/lbBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chart_body_width"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sbBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="70"
            android:progress="50" />
    </LinearLayout>

</LinearLayout>
