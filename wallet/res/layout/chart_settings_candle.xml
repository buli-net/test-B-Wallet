<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/vol_setting_padding_vertical"
    android:paddingBottom="@dimen/vol_setting_padding_vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/vol_setting_padding_vertical"
        android:text="@string/chart_settings_candle"
        android:textSize="@dimen/vol_label_text_size"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/vol_setting_padding_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chart_settings_bullish"
            android:textSize="@dimen/vol_label_text_size" />

        <View
            android:id="@+id/viewBull"
            android:layout_width="@dimen/color_picker_size"
            android:layout_height="@dimen/color_picker_size"
            android:background="@drawable/color_picker_border"
            android:tag="@color/chart_bull_default"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="@dimen/vol_value_width"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/default_popup_padding"
            android:gravity="center"
            android:text="@string/chart_settings_bearish"
            android:textSize="@dimen/vol_label_text_size" />

        <View
            android:id="@+id/viewBear"
            android:layout_width="@dimen/color_picker_size"
            android:layout_height="@dimen/color_picker_size"
            android:background="@drawable/color_picker_border"
            android:tag="@color/chart_bear_default"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="@dimen/vol_setting_padding_vertical">

        <TextView
            android:id="@+id/lbWick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chart_wick_width"
            android:textSize="@dimen/vol_label_text_size" />

        <SeekBar
            android:id="@+id/sbWick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="80"
            android:progress="10"
            android:tag="@dimen/default_wick_width" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="@dimen/vol_setting_padding_vertical">

        <TextView
            android:id="@+id/lbBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chart_body_width"
            android:textSize="@dimen/vol_label_text_size" />

        <SeekBar
            android:id="@+id/sbBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="@integer/chart_body_scale"
            android:progress="30"
            android:tag="@fraction/chart_body_base_fraction" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="@dimen/vol_setting_padding_vertical">

        <TextView
            android:id="@+id/lbVis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chart_visible_candles"
            android:textSize="@dimen/vol_label_text_size" />

        <SeekBar
            android:id="@+id/sbVis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="@integer/min_visible_candle_count"
            android:max="@integer/max_visible_candle_count"
            android:progress="@integer/default_visible_candle_count"
            android:tag="@integer/default_visible_candle_count" />
    </LinearLayout>

    <View
        android:id="@+id/def_top_padding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/default_top_padding" />

    <View
        android:id="@+id/def_bottom_padding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/default_bottom_padding" />

    <View
        android:id="@+id/def_volume_height"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/default_volume_height" />

    <View
        android:id="@+id/def_volume_top_margin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/default_volume_top_margin" />

    <View
        android:id="@+id/def_price_axis_width"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/default_price_axis_width" />

    <View
        android:id="@+id/def_time_axis_height"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/default_time_axis_height" />

    <View
        android:id="@+id/def_price_text_margin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/default_price_text_margin" />

    <View
        android:id="@+id/def_price_text_offset"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/default_price_text_offset" />

    <View
        android:id="@+id/def_grid_width"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/default_grid_width" />

    <View
        android:id="@+id/def_body_min_width"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/default_body_min_width" />

    <View
        android:id="@+id/def_body_max_width"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/default_body_max_width" />

    <View
        android:id="@+id/def_candle_min_height"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/default_candle_min_height" />

    <View
        android:id="@+id/def_dash_on"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/dash_on" />

    <View
        android:id="@+id/def_dash_off"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/dash_off" />

    <View
        android:id="@+id/def_time_text_offset"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/time_text_offset" />

    <View
        android:id="@+id/def_loading_text_offset"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/loading_text_offset" />

    <View
        android:id="@+id/def_default_text_size"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/default_text_size" />

    <View
        android:id="@+id/def_default_wick_width"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/default_wick_width" />

    <View
        android:id="@+id/def_default_body_fraction"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@fraction/chart_body_base_fraction" />

    <View
        android:id="@+id/def_min_vis"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@integer/min_visible_candle_count" />

    <View
        android:id="@+id/def_max_vis"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@integer/max_visible_candle_count" />

    <View
        android:id="@+id/def_default_vis"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@integer/default_visible_candle_count" />

    <View
        android:id="@+id/def_fetch_limit"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@integer/default_fetch_limit" />

    <View
        android:id="@+id/def_bull_color"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@color/chart_bull_default" />

    <View
        android:id="@+id/def_bear_color"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@color/chart_bear_default" />

    <View
        android:id="@+id/def_volume_alpha"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@integer/volume_alpha" />

    <View
        android:id="@+id/def_big_fiat_threshold"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@integer/big_fiat_threshold" />

    <View
        android:id="@+id/def_network_timeout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@integer/network_timeout" />

    <View
        android:id="@+id/def_live_refresh_interval"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@integer/live_refresh_interval" />

    <View
        android:id="@+id/def_countdown_interval"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@integer/countdown_interval" />

    <View
        android:id="@+id/def_min_scroll_fraction"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@fraction/min_scroll_fraction" />

    <View
        android:id="@+id/def_price_padding_fraction"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@fraction/price_padding_fraction" />

    <View
        android:id="@+id/def_candle_min_width"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/default_body_min_width" />

    <View
        android:id="@+id/def_popup_time_size"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/default_text_size" />

    <View
        android:id="@+id/def_popup_size"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/default_text_size" />

    <View
        android:id="@+id/def_body_base_fraction"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@fraction/chart_body_base_fraction" />

</LinearLayout>
