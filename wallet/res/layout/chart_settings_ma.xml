<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/vol_setting_padding_vertical"
    android:paddingBottom="@dimen/vol_setting_padding_vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/vol_setting_padding_vertical"
        android:text="@string/chart_settings_ma"
        android:textSize="@dimen/vol_label_text_size"
        android:textStyle="bold" />

    <!-- DEFAULT MA - layout @ tới integers và colors, Java chỉ đọc text của 2 thằng này -->
    <TextView
        android:id="@+id/tvDefMaPeriods"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="7,25,99"
        android:tag="@integer/default_vol_ma1_period"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvDefMaPeriods2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="25"
        android:tag="@integer/default_vol_ma2_period"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvDefMaColors"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="#FFC107,#2196F3,#E91E63"
        android:tag="@color/chart_vol_ma1_default"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_ma_popup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false" />

    <Button
        android:id="@+id/btn_add_ma"
        android:layout_width="match_parent"
        android:layout_height="@dimen/default_button_height"
        android:layout_marginTop="@dimen/vol_setting_padding_vertical"
        android:text="@string/add_ma"
        android:textAllCaps="false" />

    <!-- MA Line Width - layout @ tới dimen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="@dimen/vol_setting_padding_vertical"
        android:layout_marginTop="@dimen/vol_setting_padding_vertical">

        <TextView
            android:id="@+id/lbMaW"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chart_ma_line_width"
            android:textSize="@dimen/vol_label_text_size" />

        <SeekBar
            android:id="@+id/sbMaW"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20"
            android:progress="2"
            android:tag="@dimen/default_vol_ma_width" />
    </LinearLayout>

    <!-- Default values for Activity to read via tag - law compliance -->
    <View
        android:id="@+id/def_default_button_height"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/default_button_height" />

    <View
        android:id="@+id/def_vol_ma_width"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/default_vol_ma_width" />

    <View
        android:id="@+id/def_vol_setting_padding_vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/vol_setting_padding_vertical" />

    <View
        android:id="@+id/def_vol_label_text_size"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/vol_label_text_size" />

    <View
        android:id="@+id/def_vol_ma1_period"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@integer/default_vol_ma1_period" />

    <View
        android:id="@+id/def_vol_ma2_period"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@integer/default_vol_ma2_period" />

    <View
        android:id="@+id/def_vol_ma1_color"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@color/chart_vol_ma1_default" />

</LinearLayout>
