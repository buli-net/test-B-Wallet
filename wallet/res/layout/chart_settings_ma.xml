<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- ===================== -->
    <!-- BLOCK: Header MA -->
    <!-- ===================== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/chart_settings_ma"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- ===================== -->
    <!-- BLOCK: Default MA Periods (Hidden) -->
    <!-- No hardcode in Java, lấy từ layout -->
    <!-- ===================== -->
    <TextView
        android:id="@+id/tvDefMaPeriods"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="7,25,99"
        android:visibility="gone" />

    <!-- ===================== -->
    <!-- BLOCK: Default MA Colors (Hidden) -->
    <!-- ===================== -->
    <TextView
        android:id="@+id/tvDefMaColors"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="#FFC107,#2196F3,#E91E63"
        android:visibility="gone" />

    <!-- ===================== -->
    <!-- BLOCK: MA List Recycler -->
    <!-- ===================== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_ma_popup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false" />

    <!-- ===================== -->
    <!-- BLOCK: Add MA Button -->
    <!-- ===================== -->
    <Button
        android:id="@+id/btn_add_ma"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="@string/add_ma"
        android:textAllCaps="false" />

    <!-- ===================== -->
    <!-- BLOCK: MA Line Width -->
    <!-- FIX 4: DỜI TỪ chart_options SANG ĐÂY - Single source -->
    <!-- ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="4dp"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/lbMaW"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chart_ma_line_width"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/sbMaW"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20"
            android:progress="2" />
    </LinearLayout>

</LinearLayout>
