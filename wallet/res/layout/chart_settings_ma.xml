<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Header MA -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/chart_settings_ma"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Default periods - hidden -->
    <TextView
        android:id="@+id/tvDefMaPeriods"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="7,25,99"
        android:visibility="gone" />

    <!-- Default colors - hidden -->
    <TextView
        android:id="@+id/tvDefMaColors"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="#FFC107,#2196F3,#E91E63"
        android:visibility="gone" />

    <!-- MA list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_ma_popup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false" />

    <!-- Add MA button -->
    <Button
        android:id="@+id/btn_add_ma"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="@string/add_ma"
        android:textAllCaps="false" />

    <!-- MA line width -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/lbMaW"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chart_ma_line_width"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/sbMaW"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20"
            android:progress="2" />
    </LinearLayout>

</LinearLayout>
