<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/vol_setting_padding_vertical"
    android:paddingBottom="@dimen/vol_setting_padding_vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/vol_setting_padding_vertical"
        android:text="@string/chart_selected_section"
        android:textSize="@dimen/vol_label_text_size"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/vol_setting_padding_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chart_selected_color"
            android:textSize="@dimen/vol_label_text_size" />

        <View
            android:id="@+id/viewSelectedLine"
            android:layout_width="@dimen/color_picker_size"
            android:layout_height="@dimen/color_picker_size"
            android:background="@drawable/color_picker_border"
            android:tag="@color/chart_selected_line"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="@dimen/vol_setting_padding_vertical">

        <TextView
            android:id="@+id/lbSelectedWidth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chart_selected_width"
            android:textSize="@dimen/vol_label_text_size" />

        <SeekBar
            android:id="@+id/sbSelectedWidth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10"
            android:progress="@dimen/default_selected_width"
            android:tag="@dimen/default_grid_width" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="@dimen/vol_setting_padding_vertical">

        <TextView
            android:id="@+id/lbSelectedAlpha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chart_selected_alpha"
            android:textSize="@dimen/vol_label_text_size" />

        <SeekBar
            android:id="@+id/sbSelectedAlpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="@integer/selected_alpha"
            android:progress="@integer/selected_alpha"
            android:tag="@integer/volume_alpha" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/vol_setting_padding_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chart_selected_dashed"
            android:textSize="@dimen/vol_label_text_size" />

        <Switch
            android:id="@+id/swSelectedDash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false" />
    </LinearLayout>

</LinearLayout>
