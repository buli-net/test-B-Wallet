<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerSelected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chart_settings_selected"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/arrowSelected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arrow_collapsed"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerSelected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/chart_settings_show_selected" />

            <Switch
                android:id="@+id/swShowSelected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/chart_settings_color" />

            <View
                android:id="@+id/viewSelectedColor"
                android:layout_width="32dp"
                android:layout_height="32dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/lbSelectedWidth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chart_settings_width"
            android:layout_marginTop="12dp" />

        <SeekBar
            android:id="@+id/sbSelectedWidth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />
    </LinearLayout>
</LinearLayout>
