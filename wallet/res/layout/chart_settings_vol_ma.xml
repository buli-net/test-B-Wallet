<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Show Volume moved from Chart Options to Volume MA - master toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="@dimen/vol_setting_padding_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chart_show_volume"
            android:textSize="@dimen/vol_label_text_size" />

        <Switch
            android:id="@+id/swVol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="@dimen/vol_setting_padding_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_vol_show"
            android:textSize="@dimen/vol_label_text_size" />

        <Switch
            android:id="@+id/swVolMa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="@dimen/vol_setting_padding_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_vol_ma1"
            android:textSize="@dimen/vol_label_text_size" />

        <SeekBar
            android:id="@+id/sbVolMa1Period"
            android:layout_width="@dimen/vol_seekbar_width"
            android:layout_height="wrap_content"
            android:max="60"
            android:progress="5" />

        <TextView
            android:id="@+id/tvVolMa1Period"
            android:layout_width="@dimen/vol_value_width"
            android:layout_height="wrap_content"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="@dimen/vol_setting_padding_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_vol_ma2"
            android:textSize="@dimen/vol_label_text_size" />

        <SeekBar
            android:id="@+id/sbVolMa2Period"
            android:layout_width="@dimen/vol_seekbar_width"
            android:layout_height="wrap_content"
            android:max="60"
            android:progress="10" />

        <TextView
            android:id="@+id/tvVolMa2Period"
            android:layout_width="@dimen/vol_value_width"
            android:layout_height="wrap_content"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="@dimen/vol_setting_padding_vertical">

        <TextView
            android:id="@+id/lbVolMaW"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_vol_ma_width"
            android:textSize="@dimen/vol_label_text_size" />

        <SeekBar
            android:id="@+id/sbVolMaW"
            android:layout_width="@dimen/vol_seekbar_width"
            android:layout_height="wrap_content"
            android:max="10"
            android:progress="2" />

        <TextView
            android:id="@+id/tvVolMaW"
            android:layout_width="@dimen/vol_value_width"
            android:layout_height="wrap_content"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="@dimen/vol_setting_padding_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_vol_ma1_color"
            android:textSize="@dimen/vol_label_text_size" />

        <View
            android:id="@+id/viewVolMa1Color"
            android:layout_width="@dimen/color_picker_size"
            android:layout_height="@dimen/color_picker_size"
            android:background="@drawable/color_picker_border"
            android:tag="@color/chart_vol_ma1_default" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="@dimen/vol_setting_padding_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_vol_ma2_color"
            android:textSize="@dimen/vol_label_text_size" />

        <View
            android:id="@+id/viewVolMa2Color"
            android:layout_width="@dimen/color_picker_size"
            android:layout_height="@dimen/color_picker_size"
            android:background="@drawable/color_picker_border"
            android:tag="@color/chart_vol_ma2_default" />
    </LinearLayout>

    <!-- Default values for MarketChartView to read via tag - law compliance -->
    <!-- These invisible views expose dimens / integers via tag, Java reads tag only -->
    <View
        android:id="@+id/def_vol_ma1_period"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@integer/default_vol_ma1_period" />

    <View
        android:id="@+id/def_vol_ma2_period"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@integer/default_vol_ma2_period" />

    <View
        android:id="@+id/def_vol_ma_width"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/default_vol_ma_width" />

    <View
        android:id="@+id/def_vol_label_text_size"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/vol_label_text_size" />

    <View
        android:id="@+id/def_vol_setting_padding_vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/vol_setting_padding_vertical" />

    <View
        android:id="@+id/def_vol_seekbar_width"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/vol_seekbar_width" />

    <View
        android:id="@+id/def_vol_value_width"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/vol_value_width" />

    <View
        android:id="@+id/def_color_picker_size"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:tag="@dimen/color_picker_size" />

</LinearLayout>
