<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_vol_show" />

        <Switch
            android:id="@+id/swVolMa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_vol_ma1" />

        <SeekBar
            android:id="@+id/sbVolMa1Period"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:max="60"
            android:progress="5" />

        <TextView
            android:id="@+id/tvVolMa1Period"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_vol_ma2" />

        <SeekBar
            android:id="@+id/sbVolMa2Period"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:max="60"
            android:progress="10" />

        <TextView
            android:id="@+id/tvVolMa2Period"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_vol_ma_width" />

        <SeekBar
            android:id="@+id/sbVolMaW"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:max="10"
            android:progress="2" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_vol_ma1_color" />

        <View
            android:id="@+id/viewVolMa1Color"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_color_circle" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_vol_ma2_color" />

        <View
            android:id="@+id/viewVolMa2Color"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_color_circle" />
    </LinearLayout>

</LinearLayout>
